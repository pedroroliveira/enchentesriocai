# Aplicação
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
VITE_APP_NAME=Enchentes Vale do Caí
VITE_PUBLIC_URL=https://enchentesvaledocai.com.br
VITE_API_URL=/api
VITE_ENABLE_SOURCE_MAPPING=false
VITE_ENABLE_SSR=true
VITE_SHOW_DEV_TOOLS=false

# PostgreSQL local. Use uma senha longa e codifique caracteres especiais na URL.
DATABASE_URL=postgresql://enchentes:ALTERE_ESTA_SENHA@127.0.0.1:5432/enchentes_vale_cai
DATABASE_SSL=false

# Formulário de contato via SMTP
SMTP_HOST=smtp.seu-provedor.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@enchentesvaledocai.com.br
SMTP_PASS=ALTERE_ESTA_SENHA
SMTP_FROM=Enchentes Vale do Caí <contato@enchentesvaledocai.com.br>
CONTACT_TO=contato@enchentesvaledocai.com.br
